:italic;&#39;&gt;date&lt;/td&gt;&lt;td align=&#39;left&#39; style=&#39;padding:2px 6px;color:#b35c00;&#39;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&#39;left&#39; style=&#39;padding:2px 6px;&#39;&gt;status&lt;/td&gt;&lt;td align=&#39;left&#39; style=&#39;padding:2px 6px;color:#555;font-style:italic;&#39;&gt;enum&lt;/td&gt;&lt;td align=&#39;left&#39; style=&#39;padding:2px 6px;color:#b35c00;&#39;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
