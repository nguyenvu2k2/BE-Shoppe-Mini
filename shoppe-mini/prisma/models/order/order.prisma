model Order {
  id Int @id @default(autoincrement())

  orderCode String @unique @map("order_code")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  /// Address used at checkout. SetNull if the user later deletes it.
  addressId Int?     @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  /// Shipping snapshot — kept even if Address is edited or deleted.
  receiverName  String @map("receiver_name")
  receiverPhone String @map("receiver_phone")
  addressLine   String @map("address_line")
  ward          String
  district      String
  province      String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD) @map("payment_method")

  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  /// Snapshot of the code at checkout. Kept if the Voucher row is later edited/deleted.
  voucherId   Int?     @map("voucher_id")
  voucher     Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode String?  @map("voucher_code")

  note             String?
  cancelReason     String?   @map("cancel_reason")
  paidAt           DateTime? @map("paid_at")
  shippedAt        DateTime? @map("shipped_at")
  completedAt      DateTime? @map("completed_at")
  cancelledAt      DateTime? @map("cancelled_at")

  items         OrderItem[]
  payments      Payment[]
  voucherUsage  VoucherUsage?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([addressId])
  @@index([status])
  @@index([paymentStatus])
  @@index([voucherId])
  @@map("orders")
}
