# Host 5433 = Postgres in Docker (Windows Postgres often already uses 5432).
# Compose interpolates these into the db service and the API DATABASE_URL (@db:5432).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=shoppe-mini
DATABASE_URL="postgresql://postgres:password@localhost:5433/shoppe-mini?schema=public"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
JWT_SECRET="replace-with-a-long-random-secret"

GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
# Popup flow (@react-oauth/google useGoogleLogin auth-code) — must be exactly "postmessage"
GOOGLE_REDIRECT_URI="postmessage"

FRONTEND_URL="http://localhost:3000"

# Password reset link expiry (minutes)
PASSWORD_RESET_EXPIRY_MINUTES=30

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"
# Dev (no domain): use onboarding@resend.dev — only sends to your Resend account email
# Production: verify domain → e.g. "Shoppe Mini <noreply@yourdomain.com>"
MAIL_FROM="Shoppe Mini <onboarding@resend.dev>"

# AWS S3 — put real keys only in .env (gitignored), never commit them
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="replace-with-your-secret-access-key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET_NAME="your-bucket-name"
# Optional: custom CDN/public base; default = https://{bucket}.s3.{region}.amazonaws.com
# AWS_S3_PUBLIC_BASE_URL="https://your-bucket.s3.ap-southeast-1.amazonaws.com"

# Checkout: flat shipping (VND). Default 0.
SHIPPING_FEE_VND=0
# Unpaid COD / bank transfer auto-cancel after this many hours. Default 24.
COD_EXPIRE_HOURS=24

# Redis — local/dev. In Docker Compose this is overridden to redis://redis:6379
REDIS_URL="redis://localhost:6379"

# true = return URL marks PAID (local/Docker sandbox; IPN cannot hit localhost).
# false / omit in real production = IPN only (need a public VNP_IPN_URL).
VNP_CONFIRM_ON_RETURN=true

# --- VPS / docker-compose.prod.yml (không cần cho npm run start:dev) ---
# IMAGE_NAME=ghcr.io/<github-user>/shoppe-api
# IMAGE_TAG=latest
# API_PORT=3001
# VNP_TMN_CODE=
# VNP_HASH_SECRET=
# VNP_URL=
# VNP_RETURN_URL=
